---
import '../styles/global.css';
import LoginForm from '@components/react/LoginForm';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Login - AstroFlow</title>
    <script is:inline>
      if (localStorage.getItem('jago_auth') === 'true') {
        window.location.replace('/tracking');
      }
    </script>
  </head>
  <body class="min-h-screen bg-slate-50 flex items-center justify-center px-4">
    <div class="w-full max-w-md">
      <!-- Logo -->
      <div class="text-center mb-8">
        <a href="/" class="inline-flex items-center space-x-3">
          <div class="w-10 h-10 rounded-lg bg-[#1a2744] flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16.5 9.4l-9-5.19"/>
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
              <polyline points="3.29 7 12 12 20.71 7"/>
              <line x1="12" y1="22" x2="12" y2="12"/>
            </svg>
          </div>
          <span class="text-2xl font-bold text-[#1a2744]">AstroFlow</span>
        </a>
        <p class="mt-2 text-slate-500 text-sm">Sign in to access your shipment portal</p>
      </div>

      <!-- Card -->
      <div class="bg-white rounded-xl shadow-lg border border-slate-200 p-8">
        <h1 class="text-xl font-semibold text-slate-800 mb-6">Welcome back</h1>
        <LoginForm client:load />
      </div>

      <p class="text-center text-xs text-slate-400 mt-6">
        &copy; {new Date().getFullYear()} AstroFlow. All rights reserved.
      </p>
    </div>
  </body>
</html>
