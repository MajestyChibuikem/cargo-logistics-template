---
import { NAVIGATION } from '@config/site';
import { Package } from 'lucide-react';
import MobileMenu from '@components/react/MobileMenu';
import HeaderAuthControls from '@components/react/HeaderAuthControls';

const { currentPathname } = Astro.props;
const isActiveLink = (href: string) : boolean => { return href === currentPathname; }

---

<header class="sticky top-0 z-50 w-full border-b border-slate-200 bg-white/95 backdrop-blur-md shadow-sm">
  <nav class="container mx-auto flex h-20 items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Logo -->
    <div class="flex items-center">
      <a href="/" class="flex items-center space-x-3 group">
        <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-[#1a2744] group-hover:opacity-90 transition-opacity">
          <Package className="w-6 h-6 text-white" />
        </div>
        <span class="text-2xl font-bold text-[#1a2744]">
          AstroFlow
        </span>
      </a>
    </div>

    <!-- Desktop Navigation -->
    <div class="hidden lg:flex lg:items-center lg:space-x-1">
      {NAVIGATION.map((item) => {
        const isActive = isActiveLink(item.href);
        return (
        <a
          href={item.href}
          class={`px-4 py-2 text-sm font-medium text-slate-700 hover:text-[#f97316] hover:bg-orange-50 rounded-lg transition-all relative group ${isActive ? 'nav-active' : ''}`}
        >
          {item.name}
        </a>
      );
      })}
    </div>

    <!-- CTA + Auth Controls -->
    <div class="hidden lg:flex lg:items-center lg:space-x-3">
      <a
        href="/rfq"
        class="inline-flex items-center px-5 py-2.5 text-sm font-semibold text-white bg-[#f97316] hover:bg-[#ea6c0a] rounded-lg shadow-sm transition-all"
      >
        Request Quote
      </a>
      <HeaderAuthControls client:load />
    </div>

    <!-- Mobile Menu Button -->
    <MobileMenu client:idle />
  </nav>
</header>
